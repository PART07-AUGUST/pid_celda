# Copia a .env.edge y completa los datos del servidor OPC UA de TIA.
OPCUA_ENDPOINT=opc.tcp://PLC_IP:4840
OPCUA_USERNAME=
OPCUA_PASSWORD=
# Opcional: formato de seguridad admitido por asyncua; dejar vacío para None.
OPCUA_SECURITY_STRING=
# Opcional: reemplaza el descubrimiento de BrowseName. Debe ser JSON válido.
# OPCUA_NODE_IDS={"PV_Nivel":"ns=3;s=...","Salida_PID":"ns=3;s=..."}

RENDER_BASE_URL=https://pid-celda.onrender.com
EDGE_API_TOKEN=pon-aqui-el-mismo-secreto-configurado-en-Render

# El soft sensor virtual lee Salida_PID y escribe PV_Nivel en el PLC.
SOFT_SENSOR_ENABLED=true
SOFT_SENSOR_PV_TAG=PV_Nivel
SOFT_SENSOR_TIME_CONSTANT=18
EDGE_POLL_SECONDS=1
OPCUA_RECONNECT_SECONDS=5
PLC_COMMAND_PULSE_SECONDS=0.25
EDGE_STATE_DIR=/data
LOG_LEVEL=INFO
