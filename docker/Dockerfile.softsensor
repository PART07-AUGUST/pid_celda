FROM python:3.12-slim

WORKDIR /opt/softsensor
COPY softsensor/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY softsensor/model.py softsensor/main.py ./
RUN useradd --system --create-home softsensor && chown -R softsensor:softsensor /opt/softsensor

USER softsensor
ENV PYTHONUNBUFFERED=1 SOFTSENSOR_MODE=server
EXPOSE 4840
CMD ["python", "main.py"]
