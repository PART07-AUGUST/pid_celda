# Copiar a .env.plc solo cuando se conozcan el endpoint y los NodeIds reales.
OPCUA_ENDPOINT=opc.tcp://192.168.0.10:4840
OPCUA_SECURITY_POLICY=Basic256Sha256
OPCUA_CLIENT_CERT=/certs/softsensor.der
OPCUA_CLIENT_KEY=/certs/softsensor.pem
OPCUA_SERVER_CERT=/certs/plc.der
OPCUA_USERNAME=
OPCUA_PASSWORD=
SOFTSENSOR_ENABLE_WRITES=0
NODEID_Nivel_Pulpa=
NODEID_Caudal_Aire=
NODEID_Dosificacion_Reactivo=
NODEID_Agitador_ON=
NODEID_Recuperacion_Estimada=
NODEID_Alarma_Nivel=
NODEID_Simulacion_Activa=
NODEID_Orden_Star=
NODEID_Orden_Stop=
NODEID_Proceso_Activo=
